{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", "helpers:pinGitHubActionDigests"],
  "customManagers": [
    {
      "description": "nixpkgs commit the Attic client comes from: the nixos-unstable head",
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG NIXPKGS_REV=(?<currentDigest>[0-9a-f]{40})"],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "nixpkgs",
      "packageNameTemplate": "https://github.com/NixOS/nixpkgs",
      "currentValueTemplate": "nixos-unstable"
    },
    {
      "description": "yamllint, run by the lint job (pipx run yamllint==<version>)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["pipx run (?<depName>yamllint)==(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Everything but majors (actions, base image, Nix's image, the daily nixos-unstable bump, yamllint): merged by GitHub's auto-merge once the required checks (lint, build (amd64), build (arm64): master ruleset) passed",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
